FROM debian:stable-slim
ARG TARGETARCH
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY webui/dist /app/webui/dist
COPY webui/public /app/webui/public
COPY bin/${TARGETARCH}/kombu /usr/local/bin/kombu
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/kombu /usr/local/bin/entrypoint.sh
EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=5s --retries=5 CMD curl -f http://localhost:3000/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
